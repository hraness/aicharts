# Public browser token and regional ingest endpoint.
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_with_public_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public hostname-restricted Cloudflare Turnstile widget key for the AI Charts
# mailing-list form. The corresponding secret belongs only to Hraness Accounts.
NEXT_PUBLIC_HRANESS_MAILING_TURNSTILE_SITEKEY=replace_with_public_site_key

# Production build-only source-map credentials. Never prefix the API key with NEXT_PUBLIC_.
POSTHOG_API_KEY=phx_replace_with_private_personal_api_key
POSTHOG_PROJECT_ID=123456
POSTHOG_UI_HOST=https://us.posthog.com
