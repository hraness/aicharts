{
  "name": "aicharts",
  "version": "2.0.0",
  "description": "Reasoning effort, benchmark score and cost for AI models from Anthropic, OpenAI and Google.",
  "license": "MIT",
  "homepage": "https://aicharts.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/hraness/aicharts.git"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "data:refresh": "bun run scripts/refresh-data.ts",
    "data:check": "bun run scripts/refresh-data.ts --check",
    "check": "bun run data:check && bun run typecheck && bun run test && bun run build",
    "check:journal:browser": "node scripts/check-journal-browser.mjs",
    "showcase": "node scripts/check-journal-browser.mjs --preview"
  },
  "dependencies": {
    "@hraness/analytics": "https://github.com/hraness/posthog/releases/download/v1.2.2/hraness-analytics-1.2.2.tgz",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3"
  }
}
