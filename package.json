{
  "name": "aicharts",
  "version": "2.0.0",
  "description": "Minimal AI coding model release monitor and effort-level Pareto frontier explorer for Anthropic, OpenAI, and Google.",
  "license": "MIT",
  "homepage": "https://aicharts.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/hraness/aicharts.git"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "data:refresh": "bun run scripts/refresh-data.ts",
    "data:check": "bun run scripts/refresh-data.ts --check",
    "check": "bun run data:check && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3"
  }
}
