{
  "name": "aicharts",
  "version": "1.0.0",
  "description": "aicharts plots published AI benchmark scores against cost and tokens per task. Each chart links its source data and methodology.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://aicharts.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/hraness/aicharts.git"
  },
  "bugs": {
    "url": "https://github.com/hraness/aicharts/issues"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "ai-benchmark",
    "ai-model-comparison",
    "ai-models",
    "benchmark",
    "benchmark-visualization",
    "coding-agents",
    "data-visualization",
    "llm",
    "llm-benchmark",
    "llm-comparison",
    "machine-learning"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "kb:search": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell search --root kb --mode exact --selected-passage --rerank typesafe --rerank-limit 25",
    "kb:search:local": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell search --root kb --mode exact --selected-passage",
    "build:theme": "bun scripts/build-theme-bootstrap.ts",
    "dev": "bun run build:theme && next dev --webpack",
    "build": "bun run build:theme && bun scripts/next-webpack-build.ts && bun scripts/upload-production-source-maps.ts",
    "start": "next start",
    "analytics-routes:generate": "bun scripts/generate-public-model-card-paths.ts",
    "analytics-routes:check": "bun scripts/generate-public-model-card-paths.ts --check",
    "lint": "eslint .",
    "test": "bun test .",
    "test:browser": "bun run ./scripts/model-card-browser.ts",
    "test:property": "bun test ./lib/*.property.test.ts ./lib/*/*.property.test.ts",
    "skill:check": "bun run skill:support:check && node --check skills/aicharts/scripts/atlas.mjs && node --test skills/aicharts/scripts/atlas.check.mjs skills/aicharts/scripts/support.check.mjs",
    "typecheck": "tsc --noEmit",
    "colors:generate": "bun run scripts/generate-chart-colors.ts",
    "colors:check": "bun run scripts/generate-chart-colors.ts --check",
    "data:refresh": "bun run scripts/refresh-coding-agents.ts",
    "data:check": "bun run scripts/refresh-coding-agents.ts --check",
    "calculator:refresh": "bun run scripts/refresh-calculator-inputs.ts",
    "calculator:check": "bun run scripts/refresh-calculator-inputs.ts --check",
    "aa-intelligence:refresh": "bun run scripts/refresh-artificial-analysis-intelligence.ts",
    "aa-intelligence:check": "bun run scripts/refresh-artificial-analysis-intelligence.ts --check",
    "aa-intelligence-v4-3:refresh": "bun run scripts/refresh-artificial-analysis-intelligence-v4-3.ts",
    "aa-intelligence-v4-3:check": "bun run scripts/refresh-artificial-analysis-intelligence-v4-3.ts --check",
    "aa-weights:refresh": "bun run scripts/refresh-artificial-analysis-weights.ts",
    "aa-weights:check": "bun run scripts/refresh-artificial-analysis-weights.ts --check",
    "deepswe:refresh": "bun run scripts/refresh-deep-swe-evidence.ts",
    "deepswe:check": "bun run scripts/refresh-deep-swe-evidence.ts --check",
    "terminal-bench:refresh": "bun run scripts/refresh-terminal-bench.ts",
    "terminal-bench:check": "bun run scripts/refresh-terminal-bench.ts --check",
    "terminal-bench-science:refresh": "bun run scripts/refresh-terminal-bench-science.ts",
    "terminal-bench-science:check": "bun run scripts/refresh-terminal-bench-science.ts --check",
    "atlas:reasoning:refresh": "bun run scripts/refresh-benchmark-atlas-reasoning.ts --refresh",
    "atlas:reasoning:check": "bun run scripts/refresh-benchmark-atlas-reasoning.ts --check",
    "atlas:multimodal:refresh": "bun run scripts/refresh-benchmark-atlas-multimodal.ts --refresh",
    "atlas:multimodal:check": "bun run scripts/refresh-benchmark-atlas-multimodal.ts --check",
    "atlas:audio:refresh": "bun run scripts/refresh-benchmark-atlas-audio.ts --refresh",
    "atlas:audio:check": "bun run scripts/refresh-benchmark-atlas-audio.ts --check",
    "atlas:vals:refresh": "bun run scripts/refresh-benchmark-atlas-vals.ts --refresh",
    "atlas:vals:check": "bun run scripts/refresh-benchmark-atlas-vals.ts --check",
    "atlas:arena-media:refresh": "bun run scripts/refresh-arena-media.ts --refresh",
    "atlas:arena-media:check": "bun run scripts/refresh-arena-media.ts --check",
    "releases:refresh": "bun run scripts/refresh-model-releases.ts",
    "releases:reconcile": "bun run scripts/refresh-model-releases.ts --reconcile",
    "releases:check": "bun run scripts/refresh-model-releases.ts --check",
    "first-party-releases:refresh": "bun run scripts/refresh-first-party-releases.ts",
    "first-party-releases:check": "bun run scripts/refresh-first-party-releases.ts --check",
    "release-dates:check": "bun run scripts/check-model-release-dates.ts",
    "check:generated": "bun run colors:check && bun run data:check && bun run calculator:check && bun run aa-intelligence:check && bun run aa-intelligence-v4-3:check && bun run aa-weights:check && bun run releases:check && bun run first-party-releases:check && bun run release-dates:check && bun run deepswe:check && bun run terminal-bench:check && bun run terminal-bench-science:check && bun run atlas:reasoning:check && bun run atlas:multimodal:check && bun run atlas:audio:check && bun run atlas:arena-media:check && bun run atlas:vals:check && bun run analytics-routes:check",
    "check:cost-surfaces": "bun ./scripts/check-cost-surfaces.mjs",
    "check:changed": "bun run check",
    "check": "bun run check:cost-surfaces && bun run check:generated && bun run skill:check && bun run typecheck && bun run lint && bun run test && bun run build && bun run test:browser",
    "kb:refresh": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell refresh --root kb",
    "kb:check:lane": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell check --root kb --no-catalog",
    "kb:check": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell check --root kb && bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell agents check --root kb --repo .",
    "kb:catalog": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell catalog --root kb",
    "outputs": "bun -e 'const {mkdirSync}=require(\"node:fs\");const p=require(\"node:path\").join(process.cwd(),\"outputs\");mkdirSync(p,{recursive:true});console.log(p)'",
    "skill:support:sync": "bun run scripts/skill-support-runtime.ts",
    "skill:support:check": "bun run scripts/skill-support-runtime.ts --check",
    "sync:icons": "bun run ./scripts/sync-icons.ts",
    "security:check": "bun scripts/check-security.ts",
    "production:verify": "bun scripts/verify-production.ts"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.41.0",
    "@hraness/posthog": "https://github.com/hraness/posthog/releases/download/v0.3.11/hraness-posthog-0.3.11.tgz",
    "@hraness/site-footer": "https://github.com/hraness/site-footer/releases/download/v0.20.5/hraness-site-footer-0.20.5.tgz",
    "@hraness/ui": "github:hraness/ui#v0.5.18",
    "@hraness/vercel-delivery": "github:hraness/vercel-delivery#v0.1.2",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.13.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@posthog/nextjs-config": "1.11.3",
    "@posthog/webpack-plugin": "1.7.1",
    "next": "16.4.3",
    "posthog-js": "1.438.12",
    "posthog-node": "5.56.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.3",
    "fast-check": "^4.8.0",
    "iwanthue": "2.1.1",
    "playwright-core": "1.63.0",
    "typescript": "^6.0.3",
    "yaml": "2.9.1",
    "@hraness/support-foundation": "github:hraness/support-foundation#ed89e584c2c420e3e0547bbe8f32baf8e3a2ae4d"
  },
  "overrides": {
    "@better-auth/core": "1.7.14",
    "@better-auth/drizzle-adapter": "1.7.14",
    "@better-auth/kysely-adapter": "1.7.14",
    "better-auth": "1.7.14",
    "dompurify": "3.4.17",
    "fast-glob": "npm:tinyglobby@0.2.17",
    "fast-uri": "3.1.9",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "7.30.1",
    "vite": "8.3.3",
    "zod": "4.6.7"
  }
}
