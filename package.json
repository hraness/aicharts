{
  "name": "aicharts",
  "version": "1.0.0",
  "description": "Charts of AI model benchmarks and personal token usage: compare models and coding agents on score, cost, and speed, and measure your own agents' usage locally.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://aicharts.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/hraness/aicharts.git"
  },
  "bugs": {
    "url": "https://github.com/hraness/aicharts/issues"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "ai-benchmark",
    "ai-model-comparison",
    "ai-models",
    "benchmark",
    "benchmark-visualization",
    "coding-agents",
    "data-visualization",
    "llm",
    "llm-benchmark",
    "llm-comparison",
    "machine-learning"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "kb:search": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.22.0/hraness-wordcell-0.22.0.tgz wordcell search --root kb --mode exact --rerank typesafe --rerank-limit 25",
    "kb:search:local": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.22.0/hraness-wordcell-0.22.0.tgz wordcell search --root kb --mode exact",
    "build:theme": "bun scripts/build-theme-bootstrap.ts",
    "dev": "bun run build:theme && next dev --webpack",
    "build": "bun run build:theme && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "bun test .",
    "test:browser": "bun run ./scripts/model-card-browser.ts",
    "test:property": "bun test ./lib/*.property.test.ts",
    "usage:check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked",
    "usage:worker:types": "bun run scripts/usage-worker-tools.ts types",
    "usage:worker:test": "bun run scripts/usage-worker-tools.ts test",
    "usage:worker:check": "bun run scripts/usage-worker-tools.ts check",
    "skill:check": "bun run skill:support:check && node --check skills/aicharts/scripts/atlas.mjs && node --test skills/aicharts/scripts/atlas.check.mjs skills/aicharts/scripts/support.check.mjs",
    "release:archive:check": "node --check scripts/release/archive.mjs && node --test scripts/release/archive.check.mjs",
    "release:manifest:check": "node --check scripts/release/manifest.mjs && node --test scripts/release/manifest.check.mjs",
    "release:build:check": "node --check scripts/release/build.mjs && node --test scripts/release/build.check.mjs",
    "release:assemble:check": "node --check scripts/release/assemble.mjs && node --test scripts/release/assemble.check.mjs",
    "release:source:check": "node --check scripts/release/git-source.mjs && node --test scripts/release/git-source.check.mjs",
    "release:source:hydrate:check": "node --check scripts/release/hydrate-source.mjs && node --test scripts/release/hydrate-source.check.mjs",
    "release:linux:qualification:check": "node --check scripts/release/linux-qualification.mjs && node --test scripts/release/linux-qualification.check.mjs",
    "release:linux:runner:check": "node --check scripts/release/run-linux.mjs && node --test scripts/release/run-linux.check.mjs",
    "release:linux:notices:check": "node --check scripts/release/linux-notices.mjs && node --test scripts/release/linux-notices.check.mjs",
    "release:publish:check": "node --check scripts/release/verify-publication.mjs && node --test scripts/release/verify-publication.check.mjs && bun test scripts/release/publish-workflow.test.ts",
    "typecheck": "tsc --noEmit",
    "colors:generate": "bun run scripts/generate-chart-colors.ts",
    "colors:check": "bun run scripts/generate-chart-colors.ts --check",
    "kernel-vectors:generate": "bun run scripts/generate-kernel-vectors.ts",
    "kernel-vectors:check": "bun run scripts/generate-kernel-vectors.ts --check",
    "model-icons:generate": "bun run scripts/generate-model-card-icons.ts",
    "model-icons:check": "bun run scripts/generate-model-card-icons.ts --check",
    "data:refresh": "bun run scripts/refresh-coding-agents.ts",
    "data:check": "bun run scripts/refresh-coding-agents.ts --check",
    "calculator:refresh": "bun run scripts/refresh-calculator-inputs.ts",
    "calculator:check": "bun run scripts/refresh-calculator-inputs.ts --check",
    "aa-intelligence:refresh": "bun run scripts/refresh-artificial-analysis-intelligence.ts",
    "aa-intelligence:check": "bun run scripts/refresh-artificial-analysis-intelligence.ts --check",
    "aa-intelligence-v4-3:refresh": "bun run scripts/refresh-artificial-analysis-intelligence-v4-3.ts",
    "aa-intelligence-v4-3:check": "bun run scripts/refresh-artificial-analysis-intelligence-v4-3.ts --check",
    "deepswe:refresh": "bun run scripts/refresh-deep-swe-evidence.ts",
    "deepswe:check": "bun run scripts/refresh-deep-swe-evidence.ts --check",
    "terminal-bench:refresh": "bun run scripts/refresh-terminal-bench.ts",
    "terminal-bench:check": "bun run scripts/refresh-terminal-bench.ts --check",
    "terminal-bench-science:refresh": "bun run scripts/refresh-terminal-bench-science.ts",
    "terminal-bench-science:check": "bun run scripts/refresh-terminal-bench-science.ts --check",
    "atlas:reasoning:refresh": "bun run scripts/refresh-benchmark-atlas-reasoning.ts --refresh",
    "atlas:reasoning:check": "bun run scripts/refresh-benchmark-atlas-reasoning.ts --check",
    "atlas:multimodal:refresh": "bun run scripts/refresh-benchmark-atlas-multimodal.ts --refresh",
    "atlas:multimodal:check": "bun run scripts/refresh-benchmark-atlas-multimodal.ts --check",
    "atlas:audio:refresh": "bun run scripts/refresh-benchmark-atlas-audio.ts --refresh",
    "atlas:audio:check": "bun run scripts/refresh-benchmark-atlas-audio.ts --check",
    "atlas:vals:refresh": "bun run scripts/refresh-benchmark-atlas-vals.ts --refresh",
    "atlas:vals:check": "bun run scripts/refresh-benchmark-atlas-vals.ts --check",
    "atlas:arena-media:refresh": "bun run scripts/refresh-arena-media.ts --refresh",
    "atlas:arena-media:check": "bun run scripts/refresh-arena-media.ts --check",
    "releases:refresh": "bun run scripts/refresh-model-releases.ts",
    "releases:reconcile": "bun run scripts/refresh-model-releases.ts --reconcile",
    "releases:check": "bun run scripts/refresh-model-releases.ts --check",
    "first-party-releases:refresh": "bun run scripts/refresh-first-party-releases.ts",
    "first-party-releases:check": "bun run scripts/refresh-first-party-releases.ts --check",
    "release-dates:check": "bun run scripts/check-model-release-dates.ts",
    "check:generated": "bun run colors:check && bun run model-icons:check && bun run data:check && bun run calculator:check && bun run aa-intelligence:check && bun run aa-intelligence-v4-3:check && bun run releases:check && bun run first-party-releases:check && bun run release-dates:check && bun run deepswe:check && bun run terminal-bench:check && bun run terminal-bench-science:check && bun run atlas:reasoning:check && bun run atlas:multimodal:check && bun run atlas:audio:check && bun run atlas:arena-media:check && bun run atlas:vals:check && bun run kernel-vectors:check",
    "check:cost-surfaces": "bun ./scripts/check-cost-surfaces.mjs",
    "check": "bun run usage:assurance:check && bun run check:cost-surfaces && bun run check:generated && bun run usage:check && bun run usage:worker:check && bun run skill:check && bun run release:archive:check && bun run release:manifest:check && bun run release:build:check && bun run release:assemble:check && bun run release:source:check && bun run release:source:hydrate:check && bun run release:linux:qualification:check && bun run release:linux:notices:check && bun run release:linux:runner:check && bun run release:publish:check && bun run typecheck && bun run lint && bun run test && bun run build && bun run test:browser",
    "kb:refresh": "bunx --bun github:hraness/kb#v0.15.2 refresh --root kb",
    "kb:check:lane": "bunx --bun github:hraness/kb#v0.15.2 check --root kb --no-catalog",
    "kb:check": "bunx --bun github:hraness/kb#v0.15.2 check --root kb && bunx --bun github:hraness/kb#v0.15.2 agents check --root kb --repo .",
    "kb:catalog": "bunx --bun github:hraness/kb#v0.15.2 catalog --root kb",
    "menubar": "bun run scripts/menubar.ts",
    "menubar:install": "bun run scripts/menubar.ts install",
    "menubar:uninstall": "bun run scripts/menubar.ts uninstall",
    "menubar:status": "bun run scripts/menubar.ts status",
    "menubar:build": "bun run scripts/menubar-build.ts",
    "custody:signing": "bun run scripts/custody-signing.ts",
    "outputs": "bun -e 'const {mkdirSync}=require(\"node:fs\");const p=require(\"node:path\").join(process.cwd(),\"outputs\");mkdirSync(p,{recursive:true});console.log(p)'",
    "skill:support:sync": "bun run scripts/skill-support-runtime.ts",
    "skill:support:check": "bun run scripts/skill-support-runtime.ts --check",
    "usage:formal:tla": "bun scripts/assurance-tla.ts",
    "usage:assurance:check": "bun run scripts/assurance-registry.ts && python3 scripts/assurance-native-baseline.py && bun run usage:claims:check",
    "usage:formal:kani": "bun scripts/assurance-kani.ts",
    "usage:formal:theorems": "bun scripts/assurance-theorems.ts",
    "usage:adapters:check": "bun scripts/assurance-adapters.ts",
    "usage:conformance:check": "bun scripts/assurance-conformance.ts",
    "usage:deployment:verify": "bun scripts/usage-deployment-verify.ts",
    "usage:claims:check": "bun scripts/assurance-claims.ts"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.15.0",
    "@hraness/site-footer": "github:hraness/site-footer#v0.15.0",
    "@hraness/suite-accounts": "github:hraness/suite-accounts#v0.9.15",
    "@hraness/ui": "github:hraness/ui#v0.5.16",
    "@hraness/vercel-delivery": "github:hraness/vercel-delivery#v0.1.2",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.6.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@lobehub/icons-static-svg": "1.94.0",
    "@posthog/nextjs-config": "1.10.0",
    "@vercel/oidc": "3.8.7",
    "jose": "6.2.4",
    "next": "16.3.3",
    "posthog-js": "1.422.5",
    "posthog-node": "5.51.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.7",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.3",
    "fast-check": "^4.8.0",
    "iwanthue": "2.1.0",
    "playwright-core": "1.62.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.131.0",
    "yaml": "2.9.0",
    "@hraness/support-foundation": "github:hraness/support-foundation#ed89e584c2c420e3e0547bbe8f32baf8e3a2ae4d"
  }
}
