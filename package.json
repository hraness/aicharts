{
  "name": "codingchart.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "bun test .",
    "test:property": "bun test ./lib/*.property.test.ts",
    "typecheck": "tsc --noEmit",
    "colors:generate": "bun run scripts/generate-chart-colors.ts",
    "colors:check": "bun run scripts/generate-chart-colors.ts --check",
    "data:refresh": "bun run scripts/refresh-coding-agents.ts",
    "data:check": "bun run scripts/refresh-coding-agents.ts --check",
    "check:generated": "bun run colors:check && bun run data:check",
    "check": "bun run check:generated && bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@posthog/nextjs-config": "1.9.68",
    "next": "16.2.12",
    "posthog-js": "1.412.1",
    "posthog-node": "5.47.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.1",
    "eslint-config-next": "16.2.12",
    "fast-check": "^4.8.0",
    "iwanthue": "2.1.0",
    "typescript": "^6.0.3"
  }
}
